APP_NAME=Sistema_de_Indice
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=https://1serventiaimoveisoeiras.com.br
APP_PORT=8081

# Traefik (já existente na VPS)
TRAEFIK_ENABLE=true
TRAEFIK_NETWORK=traefik
TRAEFIK_HOST=1serventiaimoveisoeiras.com.br
TRAEFIK_ENTRYPOINT=web
TRAEFIK_ENTRYPOINT_HTTPS=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cartoriobd
DB_USERNAME=cartorio
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
DB_PUBLISH_PORT=3306
PHPMYADMIN_PORT=8080

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
